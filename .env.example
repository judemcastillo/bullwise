# Public application URL. This value is exposed to the browser.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/bullwise

# Better Auth
BETTER_AUTH_SECRET=replace-with-output-of-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# Gmail/Nodemailer
NODEMAILER_EMAIL=your-account@gmail.com
NODEMAILER_PASSWORD=replace-with-google-app-password
# Legitimate postal address displayed in optional Daily and Weekly News footers.
EMAIL_MARKETING_POSTAL_ADDRESS=replace-with-legitimate-business-postal-address
# HMAC secret for authenticated hard-bounce and complaint events. Generate with
# openssl rand -base64 32. Leave unset until an event adapter is configured.
EMAIL_EVENT_WEBHOOK_SECRET=replace-with-output-of-openssl-rand-base64-32
# Production keyring used to sign public unsubscribe links. Keep retired keys here
# until every token they signed has passed its 24-month expiration.
EMAIL_UNSUBSCRIBE_ACTIVE_KEY_ID=2026-01
EMAIL_UNSUBSCRIBE_KEYS='{"2026-01":"replace-with-output-of-openssl-rand-base64-32"}'
# Optional single-key local-development fallback. BETTER_AUTH_SECRET is used when
# neither the production keyring nor this value is configured.
# EMAIL_UNSUBSCRIBE_SECRET=replace-with-output-of-openssl-rand-base64-32

# Market data and AI
FINNHUB_API_KEY=replace-with-finnhub-api-key
GEMINI_API_KEY=replace-with-gemini-api-key

# Local Inngest Dev Server. Remove this in cloud deployments.
INNGEST_DEV=1

# Required when using Inngest Cloud; leave empty for the local Dev Server.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
